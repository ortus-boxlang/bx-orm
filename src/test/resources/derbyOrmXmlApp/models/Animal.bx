class accessors="true" persistent="true" table="animals" discriminatorColumn="animalType" {
	property name="id" generator="increment" fieldtype="id" ormType="integer";
	property name="name" ormType="string";
	property name="toys" fieldtype="one-to-many" cfc="Toy" fkcolumn="animalId" inverse="true" cascade="all-delete-orphan";
}
