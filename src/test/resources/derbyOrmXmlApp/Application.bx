class {
	this.name = "BXORMDerbyOrmXmlTest";

	this.mappings[ "/root" ] = getDirectoryFromPath( getCurrentTemplatePath() );

	this.datasources = {
		"DerbyOrmXmlDB": {
			"connectionString": "jdbc:derby:memory:ormDerbyOrmXmlTest;create=true"
		}
	};
	this.datasource = "DerbyOrmXmlDB";

	this.ormSettings = {
		"datasource"       : "DerbyOrmXmlDB",
		"dialect"          : "Derby",
		"entityPaths"      : [ "/root/models" ],
		"saveMapping"      : "true",
		"dbcreate"         : "dropcreate",
		"cacheprovider"    : "ConcurrentHashMap",
		"ignoreParseErrors": true
	};
	this.ormEnabled = "true";
}
