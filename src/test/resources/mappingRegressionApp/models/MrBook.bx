class accessors="true" persistent="true" table="mr_books" {
	property name="id" fieldtype="id" generator="increment" ormType="integer";
	property name="title" ormType="string";
	property name="active" ormType="integer";
	property name="author" fieldtype="many-to-one" cfc="MrAuthor" fkcolumn="authorId";
}
