/**
 * Declares its own getBooks(): the ORM must never replace a getter the developer wrote.
 */
class accessors="true" persistent="true" table="mr_libraries" {
	property name="id" fieldtype="id" generator="increment" ormType="integer";
	property name="name" ormType="string";
	property name="books" fieldtype="one-to-many" cfc="MrLibBook" fkcolumn="libraryId" cascade="all" type="array" singularName="book";

	function getBooks() {
		return "developer-getter";
	}
}
