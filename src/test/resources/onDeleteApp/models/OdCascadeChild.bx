// Many-to-one to OdParent that declares the database ON DELETE CASCADE.
class accessors="true" persistent="true" table="od_cascade_children" {
	property name="id" fieldtype="id" generator="increment" ormType="integer";
	property name="label" ormType="string";
	property name="parent" fieldtype="many-to-one" cfc="OdParent" fkcolumn="parentId" onDelete="cascade";
}
