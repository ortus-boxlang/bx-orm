// Many-to-one to OdParent, no onDelete attribute: bx-orm is not told the database cascades.
class accessors="true" persistent="true" table="od_children" {
	property name="id" fieldtype="id" generator="increment" ormType="integer";
	property name="label" ormType="string";
	property name="parent" fieldtype="many-to-one" cfc="OdParent" fkcolumn="parentId";
}
