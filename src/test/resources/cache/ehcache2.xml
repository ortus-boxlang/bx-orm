<?xml version="1.0" encoding="UTF-8"?>
<ehcache>
	<diskStore path="java.io.tmpdir"/>
	<defaultCache maxElementsInMemory="5000" eternal="false" timeToIdleSeconds="600" timeToLiveSeconds="1200" memoryStoreEvictionPolicy="LFU"/>
	<cache name="User" maxEntriesLocalHeap="250" timeToLiveSeconds="300" memoryStoreEvictionPolicy="CLOCK"/>
	<cache name="Lookup" eternal="true"/>
</ehcache>
