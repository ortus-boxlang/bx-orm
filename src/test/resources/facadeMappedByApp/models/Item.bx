class accessors="true" persistent="true" entityname="Item" table="fmb_items" {
	property name="id" fieldtype="id" generator="uuid" ormType="string";
	property name="label" ormType="string";

	// A binary property the modern writer skips: the facade still generates getPhoto()/setPhoto(), which Hibernate must NOT
	// auto-map (it would register the column as JAVA_OBJECT). Guards the metadata-complete behavior in facade mode.
	property name="photo" ormType="binary" notnull="false";

	// Capitalized many-to-one property name: bean getter is getOwner() -> bean attribute "owner", but the XML declares "Owner".
	property
		name     ="Owner"
		fieldtype="many-to-one"
		cfc      ="Owner"
		fkcolumn ="FK_ownerId"
		lazy     ="false";
}
